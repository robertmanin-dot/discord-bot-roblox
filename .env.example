# Kopiere diese Datei zu ".env" und trage deine Werte ein.

# Discord Developer Portal → deine Anwendung → Bot → "Reset Token"
DISCORD_TOKEN=

# Discord Developer Portal → deine Anwendung → General Information → Application ID
DISCORD_CLIENT_ID=

# Rechtsklick auf deinen Server → "Server-ID kopieren" (Entwicklermodus muss an sein)
DISCORD_GUILD_ID=

# Geheimer Schlüssel, mit dem sich das Roblox-Spiel beim Bot meldet.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Den gleichen Wert trägst du in Roblox als Secret "WW_BOT_API_KEY" ein.
GAME_API_KEY=

# Port für die Schnittstelle, die das Spiel aufruft
API_PORT=3000

# Speicherort der Datenbank
DATABASE_PATH=data/bot.db

# Zeitzone für Datumsangaben wie "24.10.2026 18:00"
TIMEZONE=Europe/Berlin
