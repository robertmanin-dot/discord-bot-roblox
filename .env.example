# Creator Launch Kit – Zugangsdaten
#
# Am einfachsten trägst du alles im Dashboard unter "Einrichtung" ein (http://localhost:3000).
# Alternativ: diese Datei zu ".env" kopieren und die Werte hinter dem "=" eintragen.
# Die Datei .env niemals teilen, hochladen oder committen.

# Discord-Bot-Token
# Developer Portal → deine Anwendung → Bot → "Reset Token"
DISCORD_TOKEN=

# YouTube Data API v3 – API-Schlüssel
# Google Cloud Console → APIs & Dienste → Anmeldedaten → API-Schlüssel
YOUTUBE_API_KEY=

# Twitch-App (optional) – dev.twitch.tv/console → Anwendung (Client-Typ: Confidential)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Passwort fürs Dashboard – nur nötig, wenn das Tool nicht nur auf deinem eigenen PC läuft
# (z. B. auf einem Server mit HOST=0.0.0.0). Beliebiger Benutzername, dieses Passwort.
DASHBOARD_PASSWORD=

# Netzwerk – Standard: nur dieser PC
# PORT=3000
# HOST=127.0.0.1

# Browser beim Start automatisch öffnen (1 = ja). Die Startskripte setzen das selbst.
# OPEN_BROWSER=1

# Ausführlichkeit der Protokolle: debug | info | warn | error
# LOG_LEVEL=info
